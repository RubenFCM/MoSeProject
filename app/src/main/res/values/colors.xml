<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Midnight Teal: the single source for Compose and Android window colors. -->
    <color name="cinema_background">#0D0F14</color>
    <color name="cinema_surface">#191D26</color>
    <color name="cinema_navigation">#DB222B36</color>
    <color name="cinema_selection">#B3303D4B</color>
    <color name="cinema_accent">#2EBAAC</color>
    <color name="cinema_text">#F5F6F8</color>
    <color name="cinema_text_secondary">#A0A8B5</color>

    <!-- Semantic exceptions: rating stars and readable production-company logos. -->
    <color name="cinema_rating">#FFCF70</color>
    <color name="cinema_logo_background">@android:color/white</color>

    <!-- Compatibility names for existing XML and shared components. -->
    <color name="purple_200">@color/cinema_accent</color>
    <color name="purple_500">@color/cinema_accent</color>
    <color name="purple_700">@color/cinema_selection</color>
    <color name="teal_200">@color/cinema_accent</color>
    <color name="teal_700">@color/cinema_accent</color>
    <color name="black">@color/cinema_background</color>
    <color name="white">@color/cinema_text</color>
    <color name="title_row">@color/cinema_text</color>
    <color name="rating">@color/cinema_rating</color>
    <color name="surface_search">@color/cinema_surface</color>
    <color name="lateral_menu">@color/cinema_surface</color>
</resources>
