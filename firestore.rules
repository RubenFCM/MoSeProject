rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
    function exact(value, fields) {
      return value is map && value.keys().hasAll(fields) && value.keys().hasOnly(fields);
    }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function nullableText(value, max) { return value == null || text(value, max); }
    function positive(value) { return value == null || (value is int && value > 0 && value <= 100000); }
    function date(value) { return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function poster(value) { return value == null || (text(value, 500) && value.matches('^/[A-Za-z0-9._/-]+$')); }
    function providers(p) {
      return p == null || (exact(p, ['region','link','subscription','free','ads','rent','buy','checkedAt'])
        && p.region is string && p.region.matches('^[A-Z]{2}$')
        && (p.link == null || (text(p.link, 2000) && p.link.matches('^https://www[.]themoviedb[.]org/.*$')))
        && p.subscription is list && p.subscription.size() <= 50
        && p.free is list && p.free.size() <= 50 && p.ads is list && p.ads.size() <= 50
        && p.rent is list && p.rent.size() <= 50 && p.buy is list && p.buy.size() <= 50
        && p.checkedAt is timestamp && p.checkedAt <= request.time);
    }
    function catalog(c, type) {
      return exact(c, ['title','posterPath','releaseDate','runtimeMinutes','providers'])
        && text(c.title, 500) && poster(c.posterPath) && date(c.releaseDate)
        && positive(c.runtimeMinutes) && (type != 'tv' || c.runtimeMinutes == null) && providers(c.providers);
    }
    function episode(e) {
      return exact(e, ['id','season','number','title','airDate','runtimeMinutes'])
        && e.id is int && e.id > 0 && e.id <= 2147483647
        && e.season is int && e.season >= 0 && e.season <= 1000
        && e.number is int && e.number > 0 && e.number <= 100000
        && nullableText(e.title, 500) && date(e.airDate) && positive(e.runtimeMinutes);
    }
    function position(p) {
      return p == null || (exact(p, ['episode','positionMinutes','mode']) && episode(p.episode)
        && p.mode in ['watching','next']
        && (p.positionMinutes == null || (p.positionMinutes is int && p.positionMinutes >= 0 && p.positionMinutes <= 100000
          && (p.episode.runtimeMinutes == null || p.positionMinutes <= p.episode.runtimeMinutes))));
    }
    function movieProgress(d) {
      let p = d.progress;
      return exact(p, ['kind','unit','positionMinutes']) && p.kind == 'movie' && p.unit == 'minutes'
        && positive(p.positionMinutes)
        && (p.positionMinutes == null || d.catalog.runtimeMinutes == null || p.positionMinutes <= d.catalog.runtimeMinutes)
        && (d.status != 'pending' || p.positionMinutes == null)
        && (d.status != 'in_progress' || p.positionMinutes == null || p.positionMinutes != d.catalog.runtimeMinutes)
        && (d.status != 'watched' || p.positionMinutes == null || p.positionMinutes == d.catalog.runtimeMinutes);
    }
    function seriesProgress(d) {
      let p = d.progress;
      return exact(p, ['kind','unit','current','lastCompleted']) && p.kind == 'tv' && p.unit == 'minutes'
        && position(p.current) && (p.lastCompleted == null || episode(p.lastCompleted))
        && (d.status != 'pending' || (p.current == null && p.lastCompleted == null))
        && (d.status != 'watched' || p.current == null)
        && (d.status != 'in_progress' || p.current != null || p.lastCompleted != null)
        && (p.current == null || p.current.mode != 'next' || (p.current.positionMinutes == 0 && p.lastCompleted != null));
    }
    function valid(d, id) {
      // episodeUpdates is a legacy field: existing values are preserved, never created or edited.
      return d.keys().hasAll(['tmdbId','mediaType','catalog','status','progress','progressVersion','createdAt','updatedAt'])
        && d.keys().hasOnly(['tmdbId','mediaType','catalog','status','progress','progressVersion','createdAt','updatedAt','episodeUpdates'])
        && d.tmdbId is int && d.tmdbId > 0 && d.tmdbId <= 2147483647 && d.mediaType in ['movie','tv']
        && id == d.mediaType + '_' + string(d.tmdbId)
        && catalog(d.catalog, d.mediaType) && d.status in ['pending','in_progress','watched']
        && ((d.mediaType == 'movie' && movieProgress(d)) || (d.mediaType == 'tv' && seriesProgress(d)))
        && d.progressVersion is int && d.progressVersion >= 0 && d.progressVersion <= 1000000000
        && d.createdAt is timestamp && d.updatedAt is timestamp && d.updatedAt >= d.createdAt;
    }
    match /users/{uid}/watchlist/{id} {
      allow get: if owner(uid);
      allow list: if owner(uid) && request.query.limit != null && request.query.limit <= 30;
      allow create: if owner(uid) && valid(request.resource.data, id)
        && !('episodeUpdates' in request.resource.data)
        && request.resource.data.status == 'pending' && request.resource.data.progressVersion == 0
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && (request.resource.data.catalog.providers == null || request.resource.data.catalog.providers.checkedAt == request.time);
      allow update: if owner(uid) && valid(request.resource.data, id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['catalog','status','progress','progressVersion','updatedAt'])
        && request.resource.data.tmdbId == resource.data.tmdbId && request.resource.data.mediaType == resource.data.mediaType
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.catalog == resource.data.catalog
            && request.resource.data.progressVersion == resource.data.progressVersion + 1)
          || (request.resource.data.catalog.diff(resource.data.catalog).affectedKeys().hasOnly(['providers'])
            && request.resource.data.catalog.providers != null && request.resource.data.catalog.providers.checkedAt == request.time
            && request.resource.data.status == resource.data.status && request.resource.data.progress == resource.data.progress
            && request.resource.data.progressVersion == resource.data.progressVersion)
        );
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
